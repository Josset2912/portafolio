---
import { perfil } from "../data/perfil";
import TechIcon from "./TechIcon.astro";
---

<section
  id="experiencia"
  class="px-6 md:px-12 py-20"
  style="background: var(--bg);"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-12 gap-12 md:gap-16 items-start">

      <!-- Left col: label + title -->
      <div class="md:col-span-4 reveal">
        <span class="section-label">/ Trayectoria</span>
        <h2 class="section-title">Experiencia laboral</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--muted);">
          {perfil.experiencia.length} posiciones en empresas de tecnología, educación y agroindustria.
        </p>
      </div>

      <!-- Right col: timeline -->
      <div class="md:col-span-8">
        <div class="relative timeline-entries">

          <!-- Línea única animada que crece con el scroll -->
          <div class="timeline-line" aria-hidden="true"></div>

          {
            perfil.experiencia.map((exp, i) => (
              <div
                class={`relative pl-10 reveal reveal-delay-${Math.min(i + 1, 4)}`}
                style={i < perfil.experiencia.length - 1 ? "padding-bottom: 3rem;" : ""}
              >
                <!-- Dot -->
                <div
                  class={`timeline-dot timeline-dot-${i} absolute flex items-center justify-center`}
                  style="left: 0; top: 4px; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border-2); background: var(--surface-2); z-index: 1;"
                >
                  <div
                    class="timeline-dot-inner"
                    style="width: 7px; height: 7px; border-radius: 50%; background: var(--border-2);"
                  />
                </div>

                <!-- Content -->
                <div>
                  <!-- Header -->
                  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 mb-2">
                    <div>
                      <h3
                        style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--text); letter-spacing: -0.02em; line-height: 1.2;"
                      >
                        {exp.empresa}
                      </h3>
                      <p class="text-sm mt-0.5" style="color: var(--accent); font-weight: 500;">
                        {exp.rol}
                      </p>
                    </div>

                    <div class="flex flex-col items-end gap-1 shrink-0">
                      <span
                        class="text-xs"
                        style="font-family: var(--font-mono); color: var(--muted-2);"
                      >
                        {exp.periodo}
                      </span>
                      <span
                        class="text-xs px-2 py-0.5"
                        style="color: var(--muted-2); border: 1px solid var(--border); border-radius: 4px; font-family: var(--font-mono); background: var(--surface);"
                      >
                        {exp.sector}
                      </span>
                    </div>
                  </div>

                  <!-- Description -->
                  <p class="text-sm leading-relaxed mb-3" style="color: var(--muted);">
                    {exp.descripcion}
                  </p>

                  <!-- Achievements -->
                  <ul class="flex flex-col gap-1.5 mb-4">
                    {exp.logros.map((logro) => (
                      <li class="flex gap-2.5 text-sm" style="color: var(--muted);">
                        <span
                          style="margin-top: 7px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); display: block; flex-shrink: 0;"
                        />
                        <span>{logro}</span>
                      </li>
                    ))}
                  </ul>

                  <!-- Stack chips -->
                  <div class="flex flex-wrap gap-2">
                    {exp.stack.map((tech) => (
                      <span class="chip">
                        <TechIcon tech={tech} size={12} />
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Education + Certifications -->
    <div class="mt-16 grid md:grid-cols-12 gap-10 md:gap-16">

      <!-- Education -->
      <div class="md:col-span-4 reveal">
        <div class="flex items-center gap-3 mb-4">
          <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-2);">Educación</span>
          <div style="flex: 1; height: 1px; background: var(--border);"></div>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent); flex-shrink: 0;" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
          <div>
            <p style="font-family: var(--font-display); font-size: 0.95rem; font-weight: 600; color: var(--text); line-height: 1.2;">{perfil.educacion.titulo}</p>
            <p style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted-2); margin-top: 3px;">{perfil.educacion.institucion}</p>
          </div>
        </div>
      </div>

      <!-- Certifications -->
      <div class="md:col-span-8 reveal reveal-delay-1">
        <div class="flex items-center gap-3 mb-4">
          <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-2);">Certificaciones</span>
          <div style="flex: 1; height: 1px; background: var(--border);"></div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem;">
          {perfil.certificaciones.map((cert) => (
            <div style="padding: 0.75rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px;">
              <p style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent); margin-bottom: 3px;">{cert.entidad}</p>
              <p style="font-size: 0.8rem; color: var(--muted); line-height: 1.35;">{cert.nombre}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<hr class="hr" />

<style>
  /* Línea vertical única animada */
  .timeline-line {
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0%,
      var(--accent-border) 60%,
      var(--border) 100%
    );
    transform: scaleY(0);
    transform-origin: top center;
    border-radius: 2px;
    will-change: transform;
  }

  /* Dot: estado inicial (apagado) */
  .timeline-dot {
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .timeline-dot-inner {
    transition: background 0.4s ease;
  }

  /* Dot: estado activo (línea lo alcanzó) */
  .timeline-dot.active {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 4px var(--accent-bg);
  }
  .timeline-dot.active .timeline-dot-inner {
    background: var(--accent) !important;
  }
</style>

<script>
  function initTimeline() {
    const entries = document.querySelector<HTMLElement>('.timeline-entries');
    const line    = document.querySelector<HTMLElement>('.timeline-line');
    if (!entries || !line) return;

    const dots = document.querySelectorAll<HTMLElement>('.timeline-dot');

    function update() {
      const rect  = entries.getBoundingClientRect();
      const viewH = window.innerHeight;

      // Progreso: 0 cuando el tope entra al viewport, 1 cuando el final llega al centro
      const progress = Math.max(0, Math.min(1,
        (viewH * 0.8 - rect.top) / (rect.height - viewH * 0.1)
      ));

      line.style.transform = `scaleY(${progress})`;

      // Activar puntos cuando la línea los alcanza
      const lineBottom = rect.top + 22 + (rect.height - 32) * progress;
      dots.forEach(dot => {
        const dotRect = dot.getBoundingClientRect();
        const dotCenterY = dotRect.top + dotRect.height / 2;
        dot.classList.toggle('active', lineBottom >= dotCenterY);
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initTimeline();
</script>
