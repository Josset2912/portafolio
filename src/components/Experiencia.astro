---
import { experiencia, formacion } from "../data/perfil";
---

<section id="experiencia" class="wrap py-16" style="border-top: 1px solid var(--border)">
  <p class="section-title m-0">Experiencia</p>

  <div class="mt-8 grid gap-10 lg:grid-cols-[2fr_1fr]">
    <ol class="list-none m-0 p-0">
      {
        experiencia.map((e, i) => (
          <li
            class="relative pb-8 pl-6"
            style={i === experiencia.length - 1 ? "" : "border-left: 1px solid var(--border)"}
          >
            <span
              class="absolute -left-[4px] top-1.5 h-2 w-2 rounded-full"
              style="background: var(--accent)"
            ></span>
            <p class="muted m-0 text-xs font-medium uppercase tracking-wide">{e.periodo}</p>
            <h3 class="mt-1 mb-0 text-base font-semibold">
              {e.puesto} · <span style="color: var(--accent)">{e.empresa}</span>
            </h3>
            <ul class="mt-3 space-y-1.5 list-disc pl-4">
              {e.logros.map((l) => (
                <li class="muted text-sm leading-relaxed">{l}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div>
      <p class="section-title m-0">Formación</p>
      <ul class="mt-5 space-y-4 list-none m-0 p-0">
        {
          formacion.map((f) => (
            <li class="card p-4">
              <h3 class="m-0 text-sm font-semibold">{f.titulo}</h3>
              <p class="muted m-0 mt-1 text-sm">{f.institucion}</p>
              <p class="muted m-0 mt-1 text-xs">{f.periodo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
