---
import { perfil } from "../data/perfil";
import TechIcon from "./TechIcon.astro";
---

<section
  id="experiencia"
  class="px-6 md:px-12 py-20"
  style="background: var(--bg);"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-12 gap-12 md:gap-16 items-start">

      <!-- Left col: label + title -->
      <div class="md:col-span-4 reveal">
        <span class="section-label">/ Trayectoria</span>
        <h2 class="section-title">Experiencia laboral</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--muted);">
          {perfil.experiencia.length} posiciones en empresas de tecnología, educación y agroindustria.
        </p>
      </div>

      <!-- Right col: timeline -->
      <div class="md:col-span-8">
        <div class="relative">

          {
            perfil.experiencia.map((exp, i) => {
              const isLast = i === perfil.experiencia.length - 1;
              return (
                <div
                  class={`relative pl-10 reveal reveal-delay-${Math.min(i + 1, 4)}`}
                  style={!isLast ? "padding-bottom: 3rem;" : ""}
                >
                  <!-- Vertical line (not on last entry) -->
                  {!isLast && (
                    <div
                      class="absolute"
                      style="left: 9px; top: 22px; bottom: 0; width: 1px; background: linear-gradient(to bottom, var(--accent-border) 0%, var(--border) 100%);"
                    />
                  )}

                  <!-- Dot -->
                  <div
                    class="absolute flex items-center justify-center"
                    style="left: 0; top: 4px; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--accent); background: var(--surface-2); z-index: 1;"
                  >
                    <div
                      style="width: 7px; height: 7px; border-radius: 50%; background: var(--accent);"
                    />
                  </div>

                  <!-- Content -->
                  <div>
                    <!-- Header -->
                    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 mb-2">
                      <div>
                        <h3
                          style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--text); letter-spacing: -0.02em; line-height: 1.2;"
                        >
                          {exp.empresa}
                        </h3>
                        <p class="text-sm mt-0.5" style="color: var(--accent); font-weight: 500;">
                          {exp.rol}
                        </p>
                      </div>

                      <div class="flex flex-col items-end gap-1 shrink-0">
                        <span
                          class="text-xs"
                          style="font-family: var(--font-mono); color: var(--muted-2);"
                        >
                          {exp.periodo}
                        </span>
                        <span
                          class="text-xs px-2 py-0.5"
                          style="color: var(--muted-2); border: 1px solid var(--border); border-radius: 4px; font-family: var(--font-mono); background: var(--surface);"
                        >
                          {exp.sector}
                        </span>
                      </div>
                    </div>

                    <!-- Description -->
                    <p class="text-sm leading-relaxed mb-3" style="color: var(--muted);">
                      {exp.descripcion}
                    </p>

                    <!-- Achievements -->
                    <ul class="flex flex-col gap-1.5 mb-4">
                      {exp.logros.map((logro) => (
                        <li class="flex gap-2.5 text-sm" style="color: var(--muted);">
                          <span
                            style="margin-top: 7px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); display: block; flex-shrink: 0;"
                          />
                          <span>{logro}</span>
                        </li>
                      ))}
                    </ul>

                    <!-- Stack chips -->
                    <div class="flex flex-wrap gap-2">
                      {exp.stack.map((tech) => (
                        <span class="chip">
                          <TechIcon tech={tech} size={12} />
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="hr" />
