---
import { perfil } from "../data/perfil";
const year = new Date().getFullYear();

const nav = [
  { href: "#sobre-mi",    label: "Sobre mí" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#stack",       label: "Stack" },
  { href: "#proyectos",   label: "Proyectos" },
  { href: "#contacto",    label: "Contacto" },
];
---

<footer style="background: var(--bg); border-top: 1px solid var(--border);">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-10">
    <div class="grid md:grid-cols-3 gap-8 mb-8">

      <!-- Brand -->
      <div>
        <a
          href="#"
          style="font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: var(--accent); letter-spacing: -0.04em; display: block; margin-bottom: 0.75rem;"
        >
          JP
        </a>
        <p class="text-sm" style="color: var(--muted-2); font-family: var(--font-mono); margin-bottom: 0.25rem;">
          Josset Yair Portuguéz Rea
        </p>
        <p class="text-xs" style="color: var(--muted-2); font-family: var(--font-mono); margin-bottom: 1rem;">
          Lima, Perú
        </p>

        <!-- Disponibilidad -->
     <!--    <span style="
          display: inline-flex;
          align-items: center;
          gap: 6px;
          font-family: var(--font-mono);
          font-size: 0.65rem;
          color: var(--green);
          background: rgba(74, 222, 128, 0.08);
          border: 1px solid rgba(74, 222, 128, 0.25);
          border-radius: 20px;
          padding: 4px 10px;
        ">
          <span class="status-dot"></span>
          Disponible para proyectos
        </span> -->
      </div>

      <!-- Mini nav -->
      <div>
        <p class="text-xs mb-3" style="font-family: var(--font-mono); letter-spacing: 0.08em; color: var(--muted-2);">NAVEGACIÓN</p>
        <ul class="flex flex-col gap-2">
          {nav.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm footer-link"
                style="color: var(--muted); font-family: var(--font-body);"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social links -->
      <div>
        <p class="text-xs mb-3" style="font-family: var(--font-mono); letter-spacing: 0.08em; color: var(--muted-2);">CONTACTO</p>
        <ul class="flex flex-col gap-3">
          <li>
            <a href={"mailto:" + perfil.contacto.email} class="footer-link footer-contact-link" style="color: var(--muted);">
              <!-- Mail icon -->
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {perfil.contacto.email}
            </a>
          </li>
          <li>
            <a href={perfil.contacto.github} target="_blank" rel="noopener noreferrer" class="footer-link footer-contact-link" style="color: var(--muted);">
              <!-- GitHub icon -->
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              Josset2912
            </a>
          </li>
          <li>
            <a href={perfil.contacto.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link footer-contact-link" style="color: var(--muted);">
              <!-- LinkedIn icon -->
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-6" style="border-top: 1px solid var(--border);">
      <p class="text-xs" style="font-family: var(--font-mono); color: var(--muted-2);">
        © {year} Josset Yair Portuguéz Rea — Todos los derechos reservados
      </p>
      <p class="text-xs" style="font-family: var(--font-mono); color: var(--muted-2);">
        Hecho con Astro · Tailwind CSS
      </p>
    </div>
  </div>
</footer>

<style>
  /* Pulsing green dot */
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.75); }
  }

  /* Nav links */
  .footer-link {
    display: inline-block;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--accent) !important; }

  /* Contact links with icon */
  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.85rem;
    font-family: var(--font-body);
  }
  .footer-contact-link svg {
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.15s;
  }
  .footer-contact-link:hover svg { opacity: 1; }
</style>
