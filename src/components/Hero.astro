---
import { perfil } from "../data/perfil";
---

<section class="wrap pt-20 pb-16 sm:pt-28">
  {
    perfil.disponible && (
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"
        style="background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border)"
      >
        <span class="h-1.5 w-1.5 rounded-full" style="background: currentColor"></span>
        Disponible para nuevos proyectos
      </p>
    )
  }

  <h1 class="m-0 text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
    {perfil.nombre}
  </h1>
  <p class="mt-3 text-xl font-medium sm:text-2xl" style="color: var(--accent)">
    {perfil.titulo}
  </p>
  <p class="muted mt-6 max-w-2xl text-lg leading-relaxed">
    {perfil.claim}
  </p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href="/#proyectos" class="btn btn-primary">Ver proyectos</a>
    <a href={perfil.cvUrl} class="btn btn-ghost" download>Descargar CV</a>
    <a href={`mailto:${perfil.email}`} class="btn btn-ghost">Escribirme</a>
  </div>

  <p class="muted mt-8 text-sm">{perfil.ubicacion} · Disponible en remoto</p>
</section>
