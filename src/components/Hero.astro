---
import { perfil } from "../data/perfil";
import { Image } from "astro:assets";
import fotoJP from "../assets/images/foto.jpg";

const roles = ["Programador Web", "Desarrollador Full-Stack", "Ingeniero de Sistemas", "Data Analyst"];
---

<section
  class="relative min-h-screen flex flex-col justify-center px-6 md:px-12 pt-20 pb-16"
  style="background: var(--bg);"
>
  <!-- Dot grid -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="
      background-image: radial-gradient(circle, var(--border) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 40%, transparent 100%);
    "
  ></div>

  <div class="relative max-w-6xl w-full mx-auto">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16 items-center">

      <!-- Left: text content -->
      <div class="md:col-span-7">

        <!-- Mobile avatar (visible only on small screens) -->
        <div class="flex md:hidden justify-center mb-8 reveal">
          <div style="position: relative; width: 100px; height: 100px;">
            <div style="position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--accent-border);"></div>
            <div style="width: 100px; height: 100px; border-radius: 50%; border: 2px solid var(--accent-border); overflow: hidden; background: var(--surface-2);">
              <Image
                src={fotoJP}
                alt="Josset Yair Portuguéz Rea"
                width={100}
                height={100}
                quality={80}
                loading="eager"
                decoding="sync"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            </div>
          </div>
        </div>

        <!-- Eyebrow -->
        <div class="mb-6 reveal">
          <span
            class="inline-flex items-center gap-2 text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2"
            style="font-family: var(--font-mono); color: var(--accent); background: var(--accent-bg); border: 1px solid var(--accent-border); border-radius: 20px;"
          >
            <span style="width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block;box-shadow: 0 0 6px var(--green);flex-shrink:0;"></span>
            {perfil.titulo}<span class="hidden sm:inline"> · <span id="typewriter-text">{perfil.subtitulo}</span><span class="cursor-blink">|</span></span>
          </span>
        </div>

        <!-- Name: each line fills the container width via fitText -->
        <h1 id="hero-name" class="hero-name mb-8 reveal reveal-delay-1" style="overflow: visible; padding-bottom: 0.1em;">
          <span class="name-line" style="display: block; white-space: nowrap;">Josset Yair</span>
          <span class="name-line" style="display: block; white-space: nowrap;">Portuguéz Rea</span>
        </h1>

        <!-- Accent separator -->
        <div class="mb-8 reveal reveal-delay-1" style="width: 48px; height: 3px; background: var(--accent); border-radius: 2px;"></div>

        <!-- Description -->
        <p
          class="text-base md:text-lg leading-relaxed mb-10 reveal reveal-delay-2"
          style="color: var(--muted); max-width: 52ch;"
        >
          {perfil.descripcion}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3 reveal reveal-delay-3">
          <a
            href="mailto:jossetpr@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold transition-all duration-200"
            style="background: var(--accent); color: white; border-radius: 8px; font-family: var(--font-body);"
            onmouseover="this.style.opacity='0.88'"
            onmouseout="this.style.opacity='1'"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Contáctame
          </a>

          <!-- CV Download -->
          <a
            href="/cv.pdf"
            download
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium transition-all duration-200"
            style="color: var(--muted); border: 1px solid var(--border-2); border-radius: 8px; font-family: var(--font-body);"
            onmouseover="this.style.color='var(--accent)'; this.style.borderColor='var(--accent-border)'"
            onmouseout="this.style.color='var(--muted)'; this.style.borderColor='var(--border-2)'"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Descargar CV
          </a>

          <a
            href={perfil.contacto.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium transition-all duration-200"
            style="color: var(--muted); border: 1px solid var(--border-2); border-radius: 8px; font-family: var(--font-body);"
            onmouseover="this.style.color='var(--accent)'; this.style.borderColor='var(--accent-border)'"
            onmouseout="this.style.color='var(--muted)'; this.style.borderColor='var(--border-2)'"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>

          <a
            href={perfil.contacto.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium transition-all duration-200"
            style="color: var(--muted); border: 1px solid var(--border-2); border-radius: 8px; font-family: var(--font-body);"
            onmouseover="this.style.color='var(--accent)'; this.style.borderColor='var(--accent-border)'"
            onmouseout="this.style.color='var(--muted)'; this.style.borderColor='var(--border-2)'"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>

        <!-- Scroll hint -->
        <div class="mt-14 reveal reveal-delay-4" style="color: var(--muted-2);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="animation: bounce 2s infinite;">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
        </div>
      </div>

      <!-- Right: avatar -->
      <div class="hidden md:flex md:col-span-5 justify-center items-center reveal reveal-delay-2">
        <div style="position: relative;">
          <!-- Ambient glow -->
          <div style="position: absolute; inset: -32px; border-radius: 50%; background: radial-gradient(circle, var(--accent-bg) 0%, transparent 68%); pointer-events: none;"></div>
          <!-- Outer ring -->
          <div style="position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--accent-border);"></div>
          <!-- Avatar -->
          <div style="width: 260px; height: 260px; border-radius: 50%; border: 2px solid var(--accent-border); overflow: hidden; background: var(--surface-2); display: flex; align-items: center; justify-content: center; position: relative;">
            <Image
              src={fotoJP}
              alt="Josset Yair Portuguéz Rea"
              width={260}
              height={260}
              quality={85}
              loading="eager"
              decoding="sync"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
            />
            <div
              id="avatar-initials"
              style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 4.5rem; font-weight: 800; color: var(--accent); letter-spacing: -0.04em; background: var(--surface-2);"
            >
              JP
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0" style="height: 1px; background: var(--border);"></div>
</section>

<style>
  @keyframes bounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%       { transform: translateY(6px); opacity: 1; }
  }

  .cursor-blink {
    animation: blink 1s step-end infinite;
    color: var(--accent);
    font-weight: 300;
  }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

</style>

<script define:vars={{ roles }}>
  (function() {
    const el = document.getElementById('typewriter-text');
    if (!el || getComputedStyle(el.parentElement).display === 'none') return;

    let roleIdx = 0;
    let charIdx = 0;
    let deleting = false;

    function tick() {
      const current = roles[roleIdx];
      if (!deleting) {
        el.textContent = current.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) {
          deleting = true;
          setTimeout(tick, 2200);
          return;
        }
        setTimeout(tick, 70);
      } else {
        el.textContent = current.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) {
          deleting = false;
          roleIdx = (roleIdx + 1) % roles.length;
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 40);
      }
    }

    setTimeout(tick, 3000);
  })();
</script>

<script>
  // FitText: scale each name line to fill the container width exactly
  function fitHeroName() {
    const container = document.getElementById('hero-name');
    if (!container) return;
    const lines = container.querySelectorAll<HTMLElement>('.name-line');
    const maxWidth = container.clientWidth;
    if (maxWidth === 0) return;
    lines.forEach(line => {
      line.style.fontSize = '10px';
      let lo = 10, hi = 600, mid = 10;
      while (lo <= hi) {
        mid = Math.floor((lo + hi) / 2);
        line.style.fontSize = mid + 'px';
        if (line.scrollWidth <= maxWidth) lo = mid + 1;
        else hi = mid - 1;
      }
      line.style.fontSize = hi + 'px';
    });
  }

  fitHeroName();
  window.addEventListener('resize', fitHeroName);
</script>
