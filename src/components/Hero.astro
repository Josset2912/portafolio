---
import { perfil } from "../data/perfil";
---

<section class="wrap pt-24 pb-20 sm:pt-32">
  {
    perfil.disponible && (
      <p
        class="mb-8 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold glass"
        style="color: var(--accent); animation: pulse 2s ease-in-out infinite;"
        data-animate="fade-up"
      >
        <span class="inline-block h-2 w-2 rounded-full" style="background: currentColor"></span>
        Disponible para nuevos desafíos
      </p>
    )
  }

  <h1 class="m-0 text-6xl sm:text-8xl font-black leading-[0.9] tracking-tighter mb-4">
    {perfil.nombre}
  </h1>

  <p class="mt-4 text-2xl sm:text-4xl font-bold" style="color: var(--accent)">
    {perfil.titulo}
  </p>

  <p class="muted mt-8 max-w-3xl text-lg sm:text-xl leading-relaxed font-light">
    {perfil.claim}
  </p>

  <div class="mt-12 flex flex-wrap items-center gap-4">
    <a href="/#proyectos" class="btn btn-primary px-8 py-3 text-base font-semibold">Ver proyectos →</a>
    <a href={perfil.cvUrl} class="btn btn-ghost px-8 py-3 text-base font-semibold" download>Descargar CV</a>
    <a href={`mailto:${perfil.email}`} class="btn btn-ghost px-8 py-3 text-base font-semibold">Contactar</a>
  </div>

  <p class="muted mt-12 text-sm font-medium">{perfil.ubicacion} · Disponible en remoto</p>
</section>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>
