---
import { perfil } from "../data/perfil";
---

<section id="contacto" class="wrap py-16" style="border-top: 1px solid var(--border)">
  <div class="card p-8 sm:p-12">
    <p class="section-title m-0">Contacto</p>
    <h2 class="mt-3 mb-0 max-w-2xl text-2xl font-semibold leading-snug sm:text-3xl">
      ¿Tienes un proyecto o una vacante donde pueda aportar?
    </h2>
    <p class="muted mt-4 max-w-xl leading-relaxed">
      Respondo en menos de 24 horas. Cuéntame el contexto y el problema; te digo con
      honestidad si puedo ayudarte.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`mailto:${perfil.email}`} class="btn btn-primary">{perfil.email}</a>
      {perfil.telefono && (
        <a href={`https://wa.me/${perfil.telefono.replace(/\D/g, "")}`} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      )}
      {
        perfil.redes.map((r) => (
          <a href={r.url} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            {r.nombre}
          </a>
        ))
      }
    </div>
  </div>
</section>
