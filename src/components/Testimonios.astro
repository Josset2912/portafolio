---
import { perfil } from "../data/perfil";
---

{perfil.testimonios.length > 0 && (
  <section
    id="testimonios"
    class="px-6 md:px-12 py-20"
    style="background: var(--bg);"
  >
    <div class="max-w-6xl mx-auto">

      <div class="mb-12 reveal">
        <span class="section-label" data-i18n-en="/ Testimonials">/ Testimonios</span>
        <h2 class="section-title" data-i18n-en="What people say">Lo que dicen</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {perfil.testimonios.map((t) => (
          <div
            class="reveal"
            style="padding: 1.5rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 14px; display: flex; flex-direction: column; gap: 1.25rem;"
          >
            <!-- Quote icon -->
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accent); opacity: 0.6; flex-shrink: 0;" aria-hidden="true">
              <path d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16-.95.1-1.956.76-3.022.66-1.065 1.515-1.867 2.558-2.403L9.373 5c-.8.396-1.56.898-2.26 1.505-.71.607-1.34 1.305-1.9 2.094s-.98 1.68-1.25 2.69-.346 2.04-.217 3.1c.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l.002.003zm9.124 0c0-.88-.23-1.618-.69-2.217-.326-.42-.77-.692-1.327-.817-.56-.124-1.074-.13-1.54-.022-.16-.94.09-1.95.75-3.02.66-1.06 1.514-1.86 2.557-2.4L18.49 5c-.8.396-1.555.898-2.26 1.505-.708.607-1.34 1.305-1.894 2.094-.556.79-.97 1.68-1.24 2.69-.273 1-.345 2.04-.217 3.1.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l.002.003z"/>
            </svg>

            <!-- Text -->
            <p style="font-size: 0.88rem; line-height: 1.7; color: var(--muted); flex-grow: 1;">
              "{t.texto}"
            </p>

            <!-- Author -->
            <div style="display: flex; align-items: center; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border);">
              <!-- Initials avatar -->
              <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-bg); border: 1px solid var(--accent-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <span style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--accent);">
                  {t.nombre.split(" ").map((n: string) => n[0]).slice(0, 2).join("")}
                </span>
              </div>
              <div>
                <p style="font-family: var(--font-display); font-size: 0.85rem; font-weight: 600; color: var(--text); line-height: 1.2;">{t.nombre}</p>
                <p style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--muted-2); margin-top: 2px;">{t.cargo} · {t.empresa}</p>
              </div>
              {t.linkedin && (
                <a
                  href={t.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="margin-left: auto; color: var(--muted-2); transition: color 0.2s;"
                  aria-label={`LinkedIn de ${t.nombre}`}
                  onmouseover="this.style.color='var(--accent)'"
                  onmouseout="this.style.color='var(--muted-2)'"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <hr class="hr" />
)}
