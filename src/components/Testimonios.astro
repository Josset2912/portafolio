---
import { perfil } from "../data/perfil";

const citas = perfil.testimonios;
const total = citas.length;
const duracion = 5; // segundos por cita
const ciclo = total * duracion;
---

{citas.length > 0 && (
  <section
    id="testimonios"
    class="px-6 md:px-12 py-16"
    style="background: var(--bg);"
  >
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="mb-10 reveal">
        <span class="section-label" data-i18n-en="/ Testimonials">/ Testimonios</span>
      </div>

      <!-- Quote display -->
      <div class="citas-wrapper reveal reveal-delay-1">
        <!-- Comilla decorativa fija -->
        <svg
          class="citas-deco"
          viewBox="0 0 48 36"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M0 36V22.5C0 10.5 7.5 3 22.5 0L25.5 4.5C18 6 13.5 10.5 12 18H21V36H0ZM27 36V22.5C27 10.5 34.5 3 49.5 0L52.5 4.5C45 6 40.5 10.5 39 18H48V36H27Z" fill="currentColor"/>
        </svg>

        <!-- Contenedor de altura fija para el ciclo -->
        <div class="citas-stage">
          {citas.map((texto, i) => (
            <p
              class="cita-item"
              style={`animation-delay: ${i * duracion}s; animation-duration: ${ciclo}s;`}
            >
              {texto}
            </p>
          ))}
        </div>

        <!-- Indicadores de progreso -->
        <div class="citas-dots" role="presentation">
          {citas.map((_, i) => (
            <span
              class="cita-dot"
              style={`animation-delay: ${i * duracion}s; animation-duration: ${ciclo}s;`}
            />
          ))}
        </div>
      </div>

    </div>
  </section>

  <hr class="hr" />
)}

<style>
  /* ── Quote block ── */
  .citas-wrapper {
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--accent-border);
  }

  .citas-deco {
    position: absolute;
    top: -0.5rem;
    left: -1.25rem;
    width: 1.75rem;
    height: auto;
    color: var(--accent);
    opacity: 0.7;
  }

  /* Fixed-height stage: quotes stack on top of each other */
  .citas-stage {
    position: relative;
    min-height: 7rem;
  }

  .cita-item {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-style: italic;
    line-height: 1.7;
    color: var(--text);
    opacity: 0;
    transform: translateY(10px);
    animation: cita-fade var(--ciclo, 40s) linear infinite both;
  }

  /*
   * Each quote: 8 quotes × 5s = 40s cycle. Each is visible for 12.5% of cycle.
   * Fade-in: 0%→1%, visible: 1%→11.5%, fade-out: 11.5%→12.5%, hidden: 12.5%→100%.
   */
  @keyframes cita-fade {
    0%     { opacity: 0; transform: translateY(10px); }
    1%     { opacity: 1; transform: translateY(0);    }
    11.5%  { opacity: 1; transform: translateY(0);    }
    12.5%  { opacity: 0; transform: translateY(-6px); }
    100%   { opacity: 0; transform: translateY(10px); }
  }

  /* Dot indicators */
  .citas-dots {
    display: flex;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .cita-dot {
    display: block;
    height: 2px;
    width: 1.5rem;
    border-radius: 2px;
    background: var(--border-2);
    position: relative;
    overflow: hidden;
  }

  .cita-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: dot-fill var(--ciclo, 40s) linear infinite both;
  }

  @keyframes dot-fill {
    0%     { transform: scaleX(0); }
    0.5%   { transform: scaleX(0); }
    12%    { transform: scaleX(1); }
    12.5%  { transform: scaleX(0); }
    100%   { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cita-item:not(:first-child) { display: none; }
    .cita-item:first-child { opacity: 1; transform: none; animation: none; position: relative; }
    .cita-dot { display: none; }
  }
</style>
