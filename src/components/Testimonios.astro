---
import { perfil } from "../data/perfil";
---

{perfil.testimonios.length > 0 && (
  <section
    id="testimonios"
    class="py-20 overflow-hidden"
    style="background: var(--bg);"
  >
    <!-- Header -->
    <div class="px-6 md:px-12 max-w-6xl mx-auto mb-14 reveal">
      <span class="section-label" data-i18n-en="/ Testimonials">/ Testimonios</span>
      <h2 class="section-title" data-i18n-en="What people say">Lo que dicen</h2>
    </div>

    <!-- Row 1: scroll left -->
    <div class="testimonios-track" aria-hidden="true">
      <div class="testimonios-inner">
        {[...perfil.testimonios, ...perfil.testimonios].map((texto) => (
          <div class="testimonio-card">
            <span class="testimonio-quote">&ldquo;</span>
            <p class="testimonio-text">{texto}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: scroll right (reverse) -->
    <div class="testimonios-track testimonios-track--reverse" style="margin-top: 1.25rem;" aria-hidden="true">
      <div class="testimonios-inner testimonios-inner--reverse">
        {[...perfil.testimonios.slice().reverse(), ...perfil.testimonios.slice().reverse()].map((texto) => (
          <div class="testimonio-card">
            <span class="testimonio-quote">&ldquo;</span>
            <p class="testimonio-text">{texto}</p>
          </div>
        ))}
      </div>
    </div>

  </section>

  <hr class="hr" />
)}

<style>
  /* Track: fade edges */
  .testimonios-track {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .testimonios-track::before,
  .testimonios-track::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 2;
    pointer-events: none;
  }
  .testimonios-track::before {
    left: 0;
    background: linear-gradient(to right, var(--bg) 0%, transparent 100%);
  }
  .testimonios-track::after {
    right: 0;
    background: linear-gradient(to left, var(--bg) 0%, transparent 100%);
  }

  /* Inner strip */
  .testimonios-inner {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    animation: marquee-left 50s linear infinite;
  }
  .testimonios-inner--reverse {
    animation-direction: reverse;
    animation-duration: 60s;
  }
  .testimonios-track:hover .testimonios-inner {
    animation-play-state: paused;
  }

  /* Individual card */
  .testimonio-card {
    position: relative;
    flex-shrink: 0;
    width: clamp(260px, 30vw, 380px);
    padding: 1.5rem 1.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.25s, background 0.25s;
    cursor: default;
  }
  .testimonio-card:hover {
    border-color: var(--accent-border);
    background: var(--surface);
  }

  /* Large decorative quote mark */
  .testimonio-quote {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.5;
    display: block;
    margin-bottom: -0.5rem;
  }

  /* Quote text */
  .testimonio-text {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--muted);
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonios-inner,
    .testimonios-inner--reverse {
      animation: none;
    }
  }
</style>
