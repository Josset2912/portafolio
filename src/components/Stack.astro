---
import { stack } from "../data/perfil";
---

<section id="stack" class="wrap py-16" style="border-top: 1px solid var(--border)">
  <p class="section-title m-0">Stack técnico</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      stack.map((grupo) => (
        <div class="card p-5">
          <h3 class="m-0 text-sm font-semibold">{grupo.grupo}</h3>
          <ul class="mt-3 flex flex-wrap gap-2 list-none m-0 p-0">
            {grupo.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
