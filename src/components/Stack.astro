---
import { stack } from "../data/perfil";
---

<section id="stack" class="wrap py-20" style="border-top: 1px solid var(--border)">
  <div class="mb-12">
    <p class="section-title m-0">Stack técnico</p>
    <p class="muted mt-3 max-w-2xl text-base">Herramientas de cada disciplina que domino</p>
  </div>

  <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-max">
    {
      stack.map((grupo, idx) => {
        const sizes = [
          "lg:col-span-1 lg:row-span-1",
          "lg:col-span-1 lg:row-span-1",
          "lg:col-span-1 lg:row-span-1",
          "lg:col-span-1 lg:row-span-1",
          "lg:col-span-1 lg:row-span-1",
          "lg:col-span-1 lg:row-span-1",
        ];
        return (
          <div
            class={`group card p-6 transition-all duration-400 hover:-translate-y-1 hover:shadow-lg cursor-default ${sizes[idx] || ""}`}
            style="border: 1px solid var(--border); position: relative; overflow: hidden;"
            data-animate="scale-in"
          >
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-400"
              style="background: linear-gradient(135deg, var(--accent-soft) 0%, transparent 100%);">
            </div>

            <div class="relative z-10">
              <p class="m-0 text-xs font-bold uppercase tracking-wider" style="color: var(--accent); margin-bottom: 0.75rem;">
                {grupo.grupo}
              </p>
              <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
                {grupo.items.map((item) => (
                  <li class="chip text-xs font-mono" style="border-color: var(--border);">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
