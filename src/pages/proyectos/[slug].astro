---
import Layout from "../../layouts/Layout.astro";
import { proyectos, perfil } from "../../data/perfil";

export function getStaticPaths() {
  return proyectos.map((p) => ({
    params: { slug: p.slug },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
---

<Layout titulo={`${proyecto.titulo} — ${perfil.nombre}`} descripcion={proyecto.resumen}>
  <article class="wrap py-16">
    <a href="/#proyectos" class="muted text-sm no-underline hover:opacity-70">← Volver a proyectos</a>

    <h1 class="mt-6 mb-0 text-3xl font-semibold leading-tight sm:text-4xl">{proyecto.titulo}</h1>
    <p class="muted mt-4 max-w-2xl text-lg leading-relaxed">{proyecto.resumen}</p>

    <ul class="mt-6 flex flex-wrap gap-2 list-none m-0 p-0">
      {proyecto.stack.map((t) => <li class="chip">{t}</li>)}
    </ul>

    {
      (proyecto.repo || proyecto.demo) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {proyecto.demo && (
            <a href={proyecto.demo} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              Ver demo
            </a>
          )}
          {proyecto.repo && (
            <a href={proyecto.repo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              Ver código
            </a>
          )}
        </div>
      )
    }

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <section class="card p-6">
        <p class="section-title m-0">El problema</p>
        <p class="muted mt-3 mb-0 leading-relaxed">{proyecto.problema}</p>
      </section>
      <section class="card p-6">
        <p class="section-title m-0">Qué construí</p>
        <p class="muted mt-3 mb-0 leading-relaxed">{proyecto.solucion}</p>
      </section>
    </div>

    <section class="card mt-8 p-6">
      <p class="section-title m-0">Resultado</p>
      <ul class="mt-4 space-y-2 list-disc pl-5" style="color: var(--text-soft)">
        {proyecto.resultado.map((r) => <li class="leading-relaxed">{r}</li>)}
      </ul>
    </section>

    <div class="mt-12" style="border-top: 1px solid var(--border)">
      <p class="muted mt-8">
        ¿Quieres algo parecido para tu equipo?{" "}
        <a href={`mailto:${perfil.email}`} class="link-accent">Escríbeme</a>.
      </p>
    </div>
  </article>
</Layout>
