---
import Layout from "../../layouts/Layout.astro";
import { perfil } from "../../data/perfil";
import TechIcon from "../../components/TechIcon.astro";

const proyecto = perfil.proyectos.find((p) => p.nombre === "Blanco Dental")!;

const problema = [
  "Las clínicas dentales gestionan información compleja: pacientes, historiales clínicos, citas, tratamientos y cobros — generalmente en papel o planillas Excel.",
  "Esto genera pérdida de datos, errores de programación y dificultad para obtener reportes de rendimiento mensual.",
  "El cliente necesitaba un sistema centralizado, accesible desde cualquier dispositivo, con control de acceso por roles.",
];

const solucion = [
  { titulo: "Dashboard con estadísticas", detalle: "Reportes mensuales de pacientes, ingresos y citas usando Recharts. El administrador visualiza el estado de la clínica en tiempo real." },
  { titulo: "Odontograma interactivo", detalle: "SVG personalizado con estado por diente. El dentista registra diagnósticos directamente sobre la imagen del odontograma." },
  { titulo: "Gestión de imágenes", detalle: "Integración con Cloudinary para subir y optimizar radiografías e imágenes clínicas con múltiples tamaños." },
  { titulo: "Autenticación JWT por roles", detalle: "Tres roles: Administrador, Dentista y Recepcionista. Cada uno accede solo a las funcionalidades que le corresponden." },
  { titulo: "Consultas optimizadas", detalle: "Prisma ORM con relaciones bien definidas y TanStack Query para caché en el cliente, minimizando peticiones innecesarias al servidor." },
];

const desafios = [
  "El odontograma requirió construir un SVG desde cero con ~32 dientes, cada uno con estado individual (sano, cariado, extraído, con corona). La gestión de ese estado fue el mayor desafío de UI.",
  "Los reportes mensuales cruzaban múltiples tablas (citas, tratamientos, pagos). Optimizar esas consultas con Prisma sin afectar el tiempo de respuesta fue clave.",
  "El control de roles debía ser granular: una recepcionista puede agendar citas pero no ver el historial clínico completo del paciente.",
];
---

<Layout
  title="Caso de estudio: Blanco Dental — Josset Portuguéz"
  description="Sistema web de gestión para clínica dental. React 19, Node.js, PostgreSQL, Prisma, Cloudinary y autenticación JWT por roles."
>
  <!-- Nav back -->
  <div style="position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 1rem 1.5rem; display: flex; align-items: center; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);">
    <a
      href="/#proyectos"
      style="display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); text-decoration: none; transition: color 0.2s;"
      onmouseover="this.style.color='var(--accent)'"
      onmouseout="this.style.color='var(--muted)'"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      Volver al portafolio
    </a>
  </div>

  <main style="padding-top: 4.5rem; min-height: 100vh; background: var(--bg);">

    <!-- Hero del caso -->
    <section style="padding: 4rem 1.5rem 3rem; max-width: 800px; margin: 0 auto;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--accent);">/ caso de estudio</span>
        <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted-2);">·</span>
        <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted-2);">2025</span>
      </div>

      <h1 style="font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 7vw, 4rem); line-height: 1; letter-spacing: -0.04em; color: var(--text); margin-bottom: 1.25rem;">
        Blanco Dental
      </h1>

      <p style="font-size: 1.05rem; line-height: 1.7; color: var(--muted); margin-bottom: 2rem; max-width: 60ch;">
        {proyecto.descripcion}
      </p>

      <!-- Links -->
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
        <a
          href={proyecto.demo}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.25rem; background: var(--accent); color: white; border-radius: 7px; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s;"
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='1'"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          Ver demo live
        </a>
        <a
          href={proyecto.github}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.25rem; border: 1px solid var(--border-2); color: var(--muted); border-radius: 7px; font-family: var(--font-mono); font-size: 0.72rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          onmouseover="this.style.borderColor='var(--accent-border)'; this.style.color='var(--accent)'"
          onmouseout="this.style.borderColor='var(--border-2)'; this.style.color='var(--muted)'"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          Ver código
        </a>
      </div>

      <!-- Stack chips -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
        {proyecto.stack.map((tech) => (
          <span style="display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.6rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted);">
            <TechIcon tech={tech} size={11} />
            {tech}
          </span>
        ))}
      </div>
    </section>

    <div style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="height: 1px; background: var(--border); margin-bottom: 3rem;"></div>
    </div>

    <!-- El problema -->
    <section style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem 3.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-2);">01</span>
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--text); letter-spacing: -0.02em;">El problema</h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {problema.map((p) => (
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="margin-top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); flex-shrink: 0; display: block;"></span>
            <p style="font-size: 0.9rem; line-height: 1.7; color: var(--muted);">{p}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- La solución -->
    <section style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem 3.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-2);">02</span>
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--text); letter-spacing: -0.02em;">La solución</h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {solucion.map((item) => (
          <div style="padding: 1.1rem 1.25rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px;">
            <p style="font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--text); margin-bottom: 0.4rem;">{item.titulo}</p>
            <p style="font-size: 0.85rem; line-height: 1.6; color: var(--muted);">{item.detalle}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Desafíos técnicos -->
    <section style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem 3.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-2);">03</span>
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--text); letter-spacing: -0.02em;">Desafíos técnicos</h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {desafios.map((d, i) => (
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--accent); flex-shrink: 0; margin-top: 2px;">{String(i + 1).padStart(2, "0")}</span>
            <p style="font-size: 0.9rem; line-height: 1.7; color: var(--muted);">{d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer CTA -->
    <section style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem 5rem;">
      <div style="height: 1px; background: var(--border); margin-bottom: 3rem;"></div>
      <p style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; color: var(--muted-2); margin-bottom: 1rem;">¿Tienes un proyecto similar?</p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a
          href="/#contacto"
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1.5rem; background: var(--accent); color: white; border-radius: 8px; font-family: var(--font-body); font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: opacity 0.2s;"
          onmouseover="this.style.opacity='0.88'"
          onmouseout="this.style.opacity='1'"
        >
          Hablemos
        </a>
        <a
          href="/#proyectos"
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1.5rem; border: 1px solid var(--border-2); color: var(--muted); border-radius: 8px; font-family: var(--font-body); font-size: 0.9rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          onmouseover="this.style.borderColor='var(--accent-border)'; this.style.color='var(--accent)'"
          onmouseout="this.style.borderColor='var(--border-2)'; this.style.color='var(--muted)'"
        >
          Ver más proyectos
        </a>
      </div>
    </section>

  </main>
</Layout>
